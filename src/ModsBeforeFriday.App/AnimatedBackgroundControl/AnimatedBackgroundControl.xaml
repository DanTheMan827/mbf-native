<UserControl
    x:Class="ModsBeforeFriday.App.Controls.AnimatedBackgroundControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsHitTestVisible="False"
    IsTabStop="False">

    <Grid Background="#FF111122">
        <canvas:CanvasAnimatedControl
            x:Name="ParticleCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ClearColor="Transparent"
            CreateResources="ParticleCanvas_CreateResources"
            Draw="ParticleCanvas_Draw" />

        <Grid Background="#44111122" />
    </Grid>
</UserControl>
