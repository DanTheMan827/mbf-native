<Page
    x:Class="ModsBeforeFriday.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer>
        <Grid MaxWidth="900" HorizontalAlignment="Stretch" Padding="28,24,28,48" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Advanced MBF and ADB configuration." Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="MBF" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Developer mode" IsOn="{x:Bind ViewModel.DeveloperMode, Mode=TwoWay}" />
                    <TextBlock Text="Developer mode bypasses the normal supported-version gate. It does not make unsupported game versions compatible with mods." Style="{StaticResource CaptionStyle}" />
                    <TextBox Header="Core mod JSON override" PlaceholderText="https://.../core_mods.json" Text="{x:Bind ViewModel.CoreModOverrideUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Game package ID" Text="{x:Bind ViewModel.GameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleSwitch Header="Ignore QMOD package ID checks" IsOn="{x:Bind ViewModel.IgnorePackageId, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="ADB server" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="The ADB protocol is transport-abstracted in the backend. The built-in transport connects to a desktop ADB daemon over TCP." Style="{StaticResource CaptionStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <TextBox Header="Host" Text="{x:Bind ViewModel.AdbHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox Grid.Column="1" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.AdbPort, Mode=TwoWay}" />
                    </Grid>
                    <TextBox Header="adb.exe path (optional)" PlaceholderText="Bundled platform-tools or PATH" Text="{x:Bind ViewModel.AdbExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Command="{x:Bind ViewModel.SaveCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
