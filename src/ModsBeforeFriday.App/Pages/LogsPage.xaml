<Page
    x:Class="ModsBeforeFriday.App.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ModsBeforeFriday.Core.Models"
    NavigationCacheMode="Disabled">

    <Grid HorizontalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" Padding="32,28,32,40" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Logs" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="MBF Rust-agent messages and on-device adb logcat capture." Style="{StaticResource CaptionStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ADB logcat" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Clear the buffer, capture while reproducing a problem, then save the resulting log." Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Start capture" Command="{x:Bind ViewModel.StartLogcatCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Stop capture" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StopLogcatCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Save log" Command="{x:Bind ViewModel.SaveLogcatCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="18,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MBF agent log" FontSize="18" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearAgentLogsCommand}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AgentLogs, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AgentLogEntry">
                            <Grid Padding="10,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Timestamp}" FontFamily="Consolas" FontSize="12" Opacity="0.6" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontFamily="Consolas" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
