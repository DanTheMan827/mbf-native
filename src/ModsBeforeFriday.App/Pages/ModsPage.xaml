<Page
    x:Class="ModsBeforeFriday.App.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModsBeforeFriday.Application.ViewModels"
    NavigationCacheMode="Disabled">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" Padding="32,28,32,48" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mods" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Manage your installed mods or browse compatible mods for this Beat Saber version." Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>

                <TabView Grid.Row="2"
                     HorizontalAlignment="Stretch"
                     IsAddTabButtonVisible="False"
                     CanReorderTabs="False"
                     HorizontalContentAlignment="Stretch">
                    <TabViewItem Header="Your Mods" IsClosable="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="0,16,0,0" Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Installed mods" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Updates are shown first, followed by non-core mods and then core mods." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Content="Sync changes"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SyncChangesCommand}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledMods, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstalledModItemViewModel">
                                        <Border Background="{ThemeResource MbfSubtleBrush}" CornerRadius="10" Padding="18" Margin="0,5">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" />
                                                        <TextBlock Text="{x:Bind Version}" Opacity="0.65" VerticalAlignment="Center" />
                                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="8" Padding="6,1" Visibility="{x:Bind IsCore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="CORE" FontSize="10" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind UpdateText}"
                                                           Foreground="{ThemeResource SystemAccentColor}"
                                                           FontWeight="SemiBold"
                                                           Visibility="{x:Bind HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="Remove" IsEnabled="{x:Bind CanRemove}" Click="RemoveMod_Click" Tag="{Binding}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabViewItem>

                    <TabViewItem Header="Install Mods" IsClosable="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="0,16,0,0" Spacing="16">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Import" FontSize="18" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="URL"
                                             PlaceholderText="https://.../mod.qmod"
                                             Text="{x:Bind ViewModel.ImportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Content="Import URL" Command="{x:Bind ViewModel.ImportUrlCommand}" VerticalAlignment="Bottom" />
                                        <Button Grid.Column="2" Content="Import files" Command="{x:Bind ViewModel.ImportFilesCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Install Mods" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Available updates are shown first." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Content="Install / update selected"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.InstallSelectedCommand}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableMods, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogModItemViewModel">
                                        <Border Background="{ThemeResource MbfSubtleBrush}" CornerRadius="10" Padding="18" Margin="0,5">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="208" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="148" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Covers are displayed in a fixed 16:9 viewport. Stretch=Uniform
                                                 letterboxes/pillarboxes rather than cropping and also scales small
                                                 images up while preserving their aspect ratio. -->
                                                <Border Width="192"
                                                    Height="108"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource MbfCardBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xECAA;"
                                                              FontSize="32"
                                                              Opacity="0.35"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                        <Image Source="{Binding Mod.Cover, Converter={StaticResource ModCoverConverter}}"
                                                           Width="192"
                                                           Height="108"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="7">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Mod.Name}" FontWeight="SemiBold" FontSize="16" />
                                                        <TextBlock Text="{x:Bind Mod.Version}" Opacity="0.65" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind UpdateLabel}" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Mod.Author, Mode=OneWay}" FontSize="12" Opacity="0.65" />
                                                    <TextBlock Text="{x:Bind Mod.Description}" Style="{StaticResource CaptionStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                        <Button Content="Source" Click="OpenSource_Click" Tag="{Binding}" />
                                                        <Button Content="Report bug"
                                                            Click="ReportBug_Click"
                                                            Tag="{Binding}"
                                                            Visibility="{x:Bind CanReportBug, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          HorizontalAlignment="Right"
        VerticalAlignment="Center"
        MinWidth="0"
        Padding="0"
                                                          ToolTipService.ToolTip="Select for batch install" />

                                                    <Button Grid.Row="2"
                                                        Content="{x:Bind ActionText}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Click="InstallMod_Click"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
