<Page
    x:Class="ModsBeforeFriday.App.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModsBeforeFriday.Application.ViewModels"
    NavigationCacheMode="Disabled">

    <ScrollViewer>
        <Grid MaxWidth="1120" HorizontalAlignment="Stretch" Padding="28,24,28,48" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Mods" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Install, update, enable, disable, and import Quest mods." Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Import" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="URL" PlaceholderText="https://.../mod.qmod" Text="{x:Bind ViewModel.ImportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Import URL" Command="{x:Bind ViewModel.ImportUrlCommand}" VerticalAlignment="Bottom" />
                        <Button Grid.Column="2" Content="Import files" Command="{x:Bind ViewModel.ImportFilesCommand}" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Installed mods" FontSize="20" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="Sync changes" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SyncChangesCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledMods, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InstalledModItemViewModel">
                                <Border Background="{ThemeResource MbfSubtleBrush}" CornerRadius="8" Padding="14" Margin="0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Version}" Opacity="0.65" />
                                                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="8" Padding="6,1" Visibility="{x:Bind IsCore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="CORE" FontSize="10" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Remove" IsEnabled="{x:Bind CanRemove}" Click="RemoveMod_Click" Tag="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Add mods" FontSize="20" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="Install / update selected" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.InstallSelectedCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableMods, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogModItemViewModel">
                                <Border Background="{ThemeResource MbfSubtleBrush}" CornerRadius="8" Padding="14" Margin="0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Mod.Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Mod.Version}" Opacity="0.65" />
                                                <TextBlock Text="{x:Bind UpdateLabel}" Foreground="{ThemeResource SystemAccentColor}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Mod.Description}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{x:Bind Mod.Author, Mode=OneWay}" FontSize="12" Opacity="0.65" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Source" Click="OpenSource_Click" Tag="{Binding}" />
                                            <Button Content="{x:Bind ActionText}" Style="{StaticResource AccentButtonStyle}" Click="InstallMod_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
