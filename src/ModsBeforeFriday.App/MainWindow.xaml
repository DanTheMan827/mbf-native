<Window
    x:Class="ModsBeforeFriday.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ModsBeforeFriday.Core.Models" xmlns:controls="using:ModsBeforeFriday.App.Controls"
    Title="Mods Before Friday">

    <!--<Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>-->

    <Grid x:Name="RootLayout" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:AnimatedBackgroundControl
        x:Name="AnimatedBackground"
        Grid.RowSpan="2"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" />

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="16,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F8;" FontSize="17" />
                <TextBlock Text="Mods Before Friday" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2"
                    Background="{ThemeResource MbfSubtleBrush}"
                    CornerRadius="14"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedDevice.DisplayName, TargetNullValue=No device}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        CompactModeThresholdWidth="641"
                        ExpandedModeThresholdWidth="1008"
                        OpenPaneLength="260"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        HorizontalContentAlignment="Stretch"
                        SelectionChanged="RootNavigation_SelectionChanged"
                        IsPaneToggleButtonVisible="False"
                        >

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ModsNavigationItem" Content="Mods" Tag="mods" IsEnabled="{Binding IsModdedDeviceConnected}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xECAA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ToolsNavigationItem" Content="Tools" Tag="tools" IsEnabled="{Binding IsModdedDeviceConnected}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Logs" Tag="logs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"
                   Background="Transparent"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
        </NavigationView>

        <!-- Global MBF-agent operation modal. It spans the title/content rows so every app control is covered. -->
        <Grid Grid.RowSpan="2"
              Canvas.ZIndex="1000"
              Background="#99000000"
              Visibility="{Binding IsAgentOperationActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border MaxWidth="760"
                    MaxHeight="520"
                    Margin="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource CardStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing IsActive="True" Width="24" Height="24" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AgentOperationTitle}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Do not disconnect the headset while this operation is running." Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{ThemeResource MbfSubtleBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <ListView x:Name="OperationLogList"
                                  ItemsSource="{Binding CurrentOperationLogs}"
                                  IsItemClickEnabled="False"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AgentLogEntry">
                                    <Grid ColumnSpacing="10" Padding="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Timestamp, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Opacity="0.55" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Level, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Opacity="0.72" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Message, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="MBF is communicating with the Rust backend on your Quest. The rest of the app is temporarily locked."
                               Style="{StaticResource CaptionStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
