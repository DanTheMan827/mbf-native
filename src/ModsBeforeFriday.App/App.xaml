<Application
    x:Class="ModsBeforeFriday.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ModsBeforeFriday.App.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        
        <controls:XamlControlsResources>
            <controls:XamlControlsResources.MergedDictionaries>
                <ResourceDictionary>

                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="MbfCardBrush" Color="#CC202020" />
                            <SolidColorBrush x:Key="MbfSubtleBrush" Color="#88202020" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="MbfCardBrush" Color="#DDF8F8F8" />
                            <SolidColorBrush x:Key="MbfSubtleBrush" Color="#99FFFFFF" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

                    <Style x:Key="CardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource MbfCardBrush}" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="Padding" Value="20" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>

                    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="24" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>

                    <Style x:Key="CaptionStyle" TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0.72" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </ResourceDictionary>
            </controls:XamlControlsResources.MergedDictionaries>
        </controls:XamlControlsResources>
        
    </Application.Resources>
</Application>
