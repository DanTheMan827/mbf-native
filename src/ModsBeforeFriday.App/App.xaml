<Application
    x:Class="ModsBeforeFriday.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ModsBeforeFriday.App.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark">

    <Application.Resources>

        <controls:XamlControlsResources>
            <controls:XamlControlsResources.MergedDictionaries>

                <ResourceDictionary>

                    <ResourceDictionary.ThemeDictionaries>

                        <!-- Dark theme -->
                        <ResourceDictionary x:Key="Default">

                            <!-- Base/nav surface -->
                            <SolidColorBrush
        x:Key="MbfBaseBrush"
        Color="#F2111122" />

                            <!-- Elevated card -->
                            <SolidColorBrush
        x:Key="MbfCardBrush"
        Color="#E6191929" />

                            <!-- Subtle/translucent panel -->
                            <SolidColorBrush
        x:Key="MbfSubtleBrush"
        Color="#99191929" />

                            <SolidColorBrush
                                x:Key="MbfNavSelected"
                                Color="#404C7DFF" />

                            <!-- Navigation pane -->
                            <SolidColorBrush
        x:Key="NavigationViewExpandedPaneBackground"
        Color="Transparent" />

                            <SolidColorBrush
        x:Key="NavigationViewDefaultPaneBackground"
        Color="Transparent" />

                            <SolidColorBrush
        x:Key="NavigationViewTopPaneBackground"
        Color="Transparent" />

                            <SolidColorBrush
        x:Key="NavigationViewItemBackgroundSelected"
        Color="#404C7DFF" />

                            <SolidColorBrush
        x:Key="NavigationViewItemBackgroundSelectedPointerOver"
        Color="#554C7DFF" />

                            <SolidColorBrush
x:Key="NavigationViewItemBackgroundPointerOver"
Color="#20FFFFFF" />


                            <SolidColorBrush
        x:Key="NavigationViewContentBackground"
        Color="Transparent" />

                            <SolidColorBrush
        x:Key="NavigationViewContentGridBorderBrush"
        Color="Transparent" />

                            <Thickness
        x:Key="NavigationViewContentGridBorderThickness">
                                1
                            </Thickness>

                            <SolidColorBrush
        x:Key="TabViewBackground"
        Color="Transparent" />

                            <SolidColorBrush
        x:Key="TabViewItemHeaderBackground"
        Color="#11AAAAFF" />

                            <SolidColorBrush
        x:Key="TabViewItemHeaderBackgroundSelected"
        Color="{ThemeResource NavigationViewItemBackgroundSelected}" />

                            <SolidColorBrush
        x:Key="TabViewItemHeaderBackgroundSelectedPointerOver"
        Color="{ThemeResource NavigationViewItemBackgroundSelectedPointerOver}" />

                            <SolidColorBrush
        x:Key="TabViewItemHeaderBackgroundPointerOver"
        Color="#22AAAAFF" />

                            <SolidColorBrush
        x:Key="TabViewItemHeaderBackgroundDisabled"
        Color="Transparent" />

                            <SolidColorBrush
        x:Key="TabViewItemSeparator"
        Color="#00000000" />

                            <SolidColorBrush
        x:Key="TabViewItemBorderBrush"
        Color="Transparent" />

                        </ResourceDictionary>

                    </ResourceDictionary.ThemeDictionaries>

                    <converters:BoolToVisibilityConverter
                        x:Key="BoolToVisibilityConverter" />

                    <converters:ModCoverConverter
                        x:Key="ModCoverConverter" />

                    <Style
                        x:Key="CardStyle"
                        TargetType="Border">

                        <Setter
                            Property="Background"
                            Value="{ThemeResource MbfCardBrush}" />

                        <Setter
                            Property="CornerRadius"
                            Value="12" />

                        <Setter
                            Property="Padding"
                            Value="24" />

                        <Setter
                            Property="BorderBrush"
                            Value="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Setter
                            Property="BorderThickness"
                            Value="1" />

                    </Style>

                    <Style
                        x:Key="SectionTitleStyle"
                        TargetType="TextBlock">

                        <Setter
                            Property="FontSize"
                            Value="24" />

                        <Setter
                            Property="FontWeight"
                            Value="SemiBold" />

                        <Setter
                            Property="TextWrapping"
                            Value="Wrap" />

                    </Style>

                    <Style
                        x:Key="CaptionStyle"
                        TargetType="TextBlock">

                        <Setter
                            Property="Opacity"
                            Value="0.72" />

                        <Setter
                            Property="TextWrapping"
                            Value="Wrap" />

                    </Style>

                </ResourceDictionary>

            </controls:XamlControlsResources.MergedDictionaries>
        </controls:XamlControlsResources>

    </Application.Resources>

</Application>
